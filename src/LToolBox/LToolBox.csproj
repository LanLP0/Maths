<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net7.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>ltb</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>ltb</ToolCommandName>
        <PackageVersion>0.0.0.0</PackageVersion>
        <Authors>LanLP</Authors>
        <Description>LanLP's math tools collection</Description>
        <!--                 <PublishAot>true</PublishAot> -->
        <StripSymbols>true</StripSymbols>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common.Cli\Common.Cli.csproj"/>
        <ProjectReference Include="..\Delta.Core\Delta.Core.csproj"/>
        <ProjectReference Include="..\LCalc\LCalc.Core.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Serilog" Version="2.12.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="4.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="RadLine" Version="0.6.0"/>
        <PackageReference Include="Spectre.Console.Cli" Version="0.46.0"/>
    </ItemGroup>

</Project>
