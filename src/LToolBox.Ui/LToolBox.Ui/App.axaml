<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="LToolBox"
             xmlns:local="using:LToolBox.Ui"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="LToolBox.Ui.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LToolBox.Ui/Styling/Resources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <!-- <StyleInclude Source="avares://FAControlsGallery/Styling/ControlsGalleryStyles.axaml" /> -->
    </Application.Styles>
</Application>