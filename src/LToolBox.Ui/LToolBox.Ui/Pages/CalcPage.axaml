<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LToolBox.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LToolBox.Ui.Pages.CalcPage">
    <Design.DataContext>
        <vm:CalcViewModel />
    </Design.DataContext>

    <DockPanel>
        <ContentControl DockPanel.Dock="Top" CornerRadius="5" Background="{DynamicResource OverlayBackgroundColor}">
            <ScrollViewer Height="200">
                <DockPanel Margin="10, 5, 10, 5">
                    <TextBlock Name="MathDisplay" DockPanel.Dock="Top" TextAlignment="Left" FontSize="15"
                               TextWrapping="NoWrap" />
                    <TextBlock Name="ResultDisplay" DockPanel.Dock="Bottom" TextAlignment="Left" FontSize="40"
                               TextWrapping="Wrap" />
                </DockPanel>
            </ScrollViewer>
        </ContentControl>
        
        <TextBox Name="MathInput" DockPanel.Dock="Top" TextChanged="MathInput_OnTextChanged" Margin="0 10 0 0"
                 Text="{Binding Math, Mode=TwoWay}" Classes="filled" Height="80" Watermark="Calculation" />
        
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*, 5, Auto" Margin="0 10 0 0">
            <Button Grid.Column="0" Click="ClearHistory" Content="Clear History" HorizontalAlignment="Stretch" />
            <CheckBox Grid.Column="2" Name="RawValueToggle" Content="Show Raw Value" IsChecked="False" />
        </Grid>
        
        <ListBox DockPanel.Dock="Bottom" DoubleTapped="HistoryBox_OnDoubleTapped" AutoScrollToSelectedItem="True"
                 Name="HistoryBox" Margin="0 10 0 0" CornerRadius="5"
                 Background="{DynamicResource OverlayBackgroundColor}" >
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </ListBox.Styles>
        </ListBox>
    </DockPanel>

</UserControl>