<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             x:Class="LToolBox.Ui.Pages.MinMaxFrac">
    <StackPanel>
        <controls:ColorZone FontSize="20" Foreground="White" Background="#30ffffff" BorderBrush="White"
                            BorderThickness="0 0 0 1" CornerRadius="5 5 0 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="A  =  " />
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10 5" Spacing="5">
                        <TextBox Classes="filled" Name="InputT0" Width="60" />
                        <TextBlock Text="x^2  +  " VerticalAlignment="Center" />
                        <TextBox Classes="filled" Name="InputT1" Width="60" />
                        <TextBlock Text="x  +  " VerticalAlignment="Center" />
                        <TextBox Classes="filled" Name="InputT2" Width="60" />
                    </StackPanel>
                    <Separator Foreground="White" Margin="0" Padding="0" />
                    <StackPanel Orientation="Horizontal" Margin="10 5" Spacing="5">
                        <TextBox Classes="filled" Name="InputB0" Width="60" />
                        <TextBlock Text="x^2  +  " VerticalAlignment="Center" />
                        <TextBox Classes="filled" Name="InputB1" Width="60" />
                        <TextBlock Text="x  +  " VerticalAlignment="Center" />
                        <TextBox Classes="filled" Name="InputB2" Width="60" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </controls:ColorZone>
        <Button Name="SubmitButton" Margin="0 10 0 0" Content="Submit" />
        <ScrollViewer Margin="0 10 0 0">
            <ListBox>
                <ListBoxItem>
                    <TextBlock Text="Test" />
                </ListBoxItem>
            </ListBox>
        </ScrollViewer>
    </StackPanel>
</UserControl>