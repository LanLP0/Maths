<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:mth="using:AvaloniaMath.Controls"
             xmlns:vmc="using:LToolBox.Ui.ViewModels.CalcPageViewModels"
             x:Class="LToolBox.Ui.Pages.CalcPages.StepsPage">

    <Design.DataContext>
        <vmc:StepsPageViewModel />
    </Design.DataContext>

    <DockPanel>
        <Button DockPanel.Dock="Top" Name="ExitButton" BorderThickness="0" Background="Transparent"
                HorizontalAlignment="Left" Foreground="{DynamicResource SystemAccentColor}"
                Click="ExitButtonClicked" Content="&lt; Return" Margin="0 0 0 20" />

        <ScrollViewer DockPanel.Dock="Bottom">
            <StackPanel>

                <mth:FormulaBlock Name="FormulaBlock" Formula="{Binding Formula}"
                                  Foreground="{DynamicResource TextControlForeground}" Padding="0 5" />
                <TextBlock Name="ResultBlock" Foreground="{DynamicResource SystemAccentColor}"
                           Text="{Binding Path=ResultText}" TextWrapping="Wrap"
                           FontSize="30" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>