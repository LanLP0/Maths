<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LToolBox.Ui.ViewModels"
             xmlns:ui="clr-namespace:LToolBox.Ui"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LToolBox.Ui.Pages.PolynomialPage">
    <Design.DataContext>
        <vm:PolynomialPageViewModel />
    </Design.DataContext>

    <DockPanel>
        <ContentControl DockPanel.Dock="Top" FontSize="20"
                        Background="{DynamicResource SystemAccentColor}"
                        BorderBrush="{DynamicResource TextControlBorderBrush}"
                        BorderThickness="0, 0, 0, 1"
                        CornerRadius="5, 5, 0, 0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="10 30">

                    <StackPanel Name="InputGroup5" Orientation="Horizontal">
                        <TextBox x:Name="Input5" KeyDown="Input5_OnKeyDown"
                                 Watermark="0" />
                        <TextBlock Text="x^5 + " />
                    </StackPanel>

                    <StackPanel Name="InputGroup4" Orientation="Horizontal">
                        <TextBox x:Name="Input4" KeyDown="Input4_OnKeyDown"
                                 Watermark="0" />
                        <TextBlock Text="x^4 + " />
                    </StackPanel>

                    <StackPanel Name="InputGroup3" Orientation="Horizontal">
                        <TextBox x:Name="Input3" KeyDown="Input3_OnKeyDown"
                                 Watermark="0" />
                        <TextBlock Text="x^3 + " />
                    </StackPanel>

                    <TextBox x:Name="Input2" KeyDown="Input2_OnKeyDown"
                             Watermark="0" />
                    <TextBlock Text="x^2 + " />

                    <TextBox x:Name="Input1" KeyDown="Input1_OnKeyDown"
                             Watermark="0" />
                    <TextBlock Text="x + " />

                    <TextBox x:Name="Input0" KeyDown="Input0_OnKeyDown"
                             Watermark="0" />

                    <TextBlock Text=" = 0" />
                </StackPanel>
            </ScrollViewer>
        </ContentControl>

        <Grid DockPanel.Dock="Top" Margin="0 10 0 0" ColumnDefinitions="*, 5, Auto, 5, Auto, 5, Auto">

            <Button Grid.Column="0" Click="SubmitPressed" Name="SubmitButton" Content="Submit"
                    HorizontalAlignment="Stretch" />

            <ComboBox Name="DegreeSelector" Grid.Column="2" SelectionChanged="OnDegreeChanged">
                <ComboBoxItem>x^2</ComboBoxItem>
                <ComboBoxItem>x^3</ComboBoxItem>
                <ComboBoxItem>x^4</ComboBoxItem>
                <ComboBoxItem>x^5</ComboBoxItem>
            </ComboBox>

            <Button Grid.Column="4" Click="ClearHistoryButtonPressed" Name="ClearHistoryButton"
                    Content="Clear History" />

            <Button Grid.Column="6" Click="ClearButtonPressed" Name="ClearButton" Content="Clear" />

        </Grid>

        <TextBlock DockPanel.Dock="Top" Name="ErrorDisplay" Margin="0 5 0 0"
                   Foreground="Red" IsVisible="False" TextWrapping="Wrap" />

        <Separator DockPanel.Dock="Top" Margin="0 2 0 5" />

        <ScrollViewer DockPanel.Dock="Bottom">
            <ListBox DoubleTapped="HistoryBox_OnDoubleTapped" Name="HistoryBox" AutoScrollToSelectedItem="True"
                     Margin="0 10 0 0" ItemsSource="{Binding Histories}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="ui:PolynomialHistory">
                        <TextBlock Text="{Binding RenderText}"
                                   TextWrapping="Wrap" Padding="10 20" />
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </ScrollViewer>
    </DockPanel>
</UserControl>