<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LToolBox.Ui.Views.MainView">
    <!-- xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles" -->

    <ui:NavigationView AlwaysShowHeader="True"
                       PaneTitle="LToolBox"
                       PaneDisplayMode="LeftCompact"
                       Name="NavView"
                       IsSettingsVisible="False"
                       ItemInvoked="OnNavigationViewItemInvoked" BackRequested="OnNavigationViewBackRequested">
        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItem IconSource="DarkTheme" Content="Switch theme" Tag="theme-switch"
                                   SelectsOnInvoked="False" />
        </ui:NavigationView.FooterMenuItems>

        <StackPanel>
            <TextBlock Name="PageHeader" TextAlignment="Center" FontSize="30" />
            <ui:Frame Name="FrameView" Padding="10" Navigated="OnFrameViewNavigated" />
        </StackPanel>
    </ui:NavigationView>

</UserControl>