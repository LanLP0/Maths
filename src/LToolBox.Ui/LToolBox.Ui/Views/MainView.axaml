<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:LToolBox.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LToolBox.Ui.Views.MainView"
             SizeChanged="OnSizeChanged">
    <Design.DataContext>
        <vm:MainViewViewModel />
    </Design.DataContext>

    <ui:NavigationView AlwaysShowHeader="True"
                       PaneTitle="LToolBox"
                       PaneDisplayMode="LeftCompact"
                       Name="NavView"
                       IsSettingsVisible="False"
                       SelectedItem="{Binding SelectedItem}"
                       ItemInvoked="OnNavigationViewItemInvoked" BackRequested="OnNavigationViewBackRequested">

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Name="PageHeader" Text="{Binding HeaderText}" TextAlignment="Center" FontSize="25" />
            <ui:Frame DockPanel.Dock="Bottom" Name="FrameView" Padding="10" Navigated="OnFrameViewNavigated" />
        </DockPanel>
    </ui:NavigationView>

</UserControl>