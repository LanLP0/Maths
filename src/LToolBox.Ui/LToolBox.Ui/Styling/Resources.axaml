<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:FluentAvalonia.UI.Controls">
    <ui:SymbolIconSource x:Key="CalculatorIcon" Symbol="CalculatorFilled" />
    <ui:PathIconSource x:Key="DivideIcon"
                       Data="M 18,10 H 6 a 2,2 0 0 0 0,4 h 12 a 2,2 0 0 0 0,-4 z m -3.75,8 A 2.25,2.25 0 0 1 12,20.25 2.25,2.25 0 0 1 9.75,18 2.25,2.25 0 0 1 12,15.75 2.25,2.25 0 0 1 14.25,18 Z m 0,-12 A 2.25,2.25 0 0 1 12,8.25 2.25,2.25 0 0 1 9.75,6 2.25,2.25 0 0 1 12,3.75 2.25,2.25 0 0 1 14.25,6 Z" />
    <ui:SymbolIconSource x:Key="SettingsIcon" Symbol="SettingsFilled" />
    <ui:SymbolIconSource x:Key="DarkThemeIcon" Symbol="DarkTheme" />

    <SolidColorBrush x:Key="OverlayBackgroundColor" Color="#D6F418FF" />
    
    <Thickness x:Key="CornerRadius1">5</Thickness>
</ResourceDictionary>