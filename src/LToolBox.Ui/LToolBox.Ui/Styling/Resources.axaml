<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:FluentAvalonia.UI.Controls">
    <FontFamily x:Key="NotoSansMonoFont">avares://LToolBox.Ui/Assets/Fonts#Noto Sans Mono</FontFamily>
    <FontFamily x:Key="RomanSerifFont">avares://LToolBox.Ui/Assets/Fonts#RomanSerif</FontFamily>
    <FontFamily x:Key="3270NerdFontMono">avares://LToolBox.Ui/Assets/Fonts#3270 Nerd Font Mono</FontFamily>

    <ui:SymbolIconSource x:Key="CalculatorIcon" Symbol="CalculatorFilled" />
    <ui:PathIconSource x:Key="DivideIcon"
                       Data="M 18,10 H 6 a 2,2 0 0 0 0,4 h 12 a 2,2 0 0 0 0,-4 z m -3.75,8 A 2.25,2.25 0 0 1 12,20.25 2.25,2.25 0 0 1 9.75,18 2.25,2.25 0 0 1 12,15.75 2.25,2.25 0 0 1 14.25,18 Z m 0,-12 A 2.25,2.25 0 0 1 12,8.25 2.25,2.25 0 0 1 9.75,6 2.25,2.25 0 0 1 12,3.75 2.25,2.25 0 0 1 14.25,6 Z" />
    <ui:SymbolIconSource x:Key="SettingsIcon" Symbol="SettingsFilled" />
    <ui:SymbolIconSource x:Key="DarkThemeIcon" Symbol="DarkTheme" />
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="Transparent20" Color="#14000000" />
    <SolidColorBrush x:Key="Transparent40" Color="#28000000" />
    <SolidColorBrush x:Key="Transparent60" Color="#3c000000" />
    <SolidColorBrush x:Key="Transparent80" Color="#50000000" />

    <!-- Keyboard icons -->
    <ui:FontIconSource x:Key="AKeyIcon" Glyph="a" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="BKeyIcon" Glyph="b" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="CKeyIcon" Glyph="c" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="DKeyIcon" Glyph="d" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="EKeyIcon" Glyph="e" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="FKeyIcon" Glyph="f" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="GKeyIcon" Glyph="g" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="HKeyIcon" Glyph="h" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="IKeyIcon" Glyph="i" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="JKeyIcon" Glyph="j" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="KKeyIcon" Glyph="k" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="LKeyIcon" Glyph="l" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="MKeyIcon" Glyph="m" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="NKeyIcon" Glyph="n" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="OKeyIcon" Glyph="o" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="PKeyIcon" Glyph="p" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="QKeyIcon" Glyph="q" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="RKeyIcon" Glyph="r" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="SKeyIcon" Glyph="s" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="TKeyIcon" Glyph="t" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="UKeyIcon" Glyph="u" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="VKeyIcon" Glyph="v" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="WKeyIcon" Glyph="w" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="XKeyIcon" Glyph="x" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="YKeyIcon" Glyph="y" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="ZKeyIcon" Glyph="z" FontFamily="{StaticResource NotoSansMonoFont}" />

    <!-- Calc icons -->
    <ui:FontIconSource x:Key="OneIcon" Glyph="1" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="TwoIcon" Glyph="2" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="ThreeIcon" Glyph="3" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="FourIcon" Glyph="4" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="FiveIcon" Glyph="5" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="SixIcon" Glyph="6" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="SevenIcon" Glyph="7" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="EightIcon" Glyph="8" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="NineIcon" Glyph="9" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="ZeroIcon" Glyph="0" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="DotIcon" Glyph="." FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="PiIcon" Glyph="󰏿" FontFamily="{StaticResource 3270NerdFontMono}" />
    <ui:FontIconSource x:Key="AnsIcon" Glyph="ans" FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="LeftArrowIcon" Glyph="&#xE7EA;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
    <ui:FontIconSource x:Key="RightArrowIcon" Glyph="&#xEA62;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
    <ui:FontIconSource x:Key="CommaKeyIcon" Glyph="," />
    <ui:FontIconSource x:Key="PowerIcon" Glyph="^"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="PowerTwoIcon" Glyph="^2"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="ModuloIcon" Glyph="%"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="PlusIcon" Glyph="+"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="MinusIcon" Glyph="-"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="MultiplyIcon" Glyph="*"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="Divide1Icon" Glyph="/"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="FactorialIcon" Glyph="!"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="AndIcon" Glyph="&amp;"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="OrIcon" Glyph="|"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="GreaterThanIcon" Glyph=">"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="EqualIcon" Glyph="="
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="LessThanIcon" Glyph="&lt;"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:SymbolIconSource x:Key="SwitchIcon" Symbol="Switch" Foreground="{DynamicResource SystemAccentColor}" />
    <ui:FontIconSource x:Key="BracesIcon" Glyph="()"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="CustomFunctionIcon" Glyph="[f()]"
                       FontFamily="{StaticResource RomanSerifFont}" />
    <ui:FontIconSource x:Key="FunctionIcon" Glyph="f(x)"
                       FontFamily="{StaticResource RomanSerifFont}" />
    <ui:FontIconSource x:Key="AssignIcon" Glyph="&amp;x="
                       FontFamily="{StaticResource RomanSerifFont}" />
    <ui:FontIconSource x:Key="SinIcon" Glyph="sin"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="CosIcon" Glyph="cos"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:FontIconSource x:Key="TanIcon" Glyph="tan"
                       FontFamily="{StaticResource NotoSansMonoFont}" />
    <ui:PathIconSource x:Key="SquareRootIcon"
